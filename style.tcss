#songs {
  height: 1fr;
}

#player {
  height: auto;
}

#controls {
  height: 7;
  padding: 1 1;
  align-vertical: middle;
}

#nowplaying {
  width: 1fr;
  height: 5;
}

#cover {
  width: 10;
  height: 5;
}

#info {
  width: 1fr;
  height: 5;
  padding-left: 1;
  align-vertical: middle;
}

#title {
  text-style: bold;
}

#artist {
  color: $text-muted;
}

/* Center column: play button with the progress bar beneath it */
#center {
  width: 1fr;
  height: 5;
  align: center middle;
}

#play {
  width: 8;
  min-width: 8;
}

#progress-row {
  width: 25vw;        /* 25% of the window width */
  max-width: 100%;    /* don't overflow the column on narrow windows */
  height: 1;
}

#elapsed,
#duration {
  width: 6;
  color: $text-muted;
}

#elapsed {
  text-align: left;
}

#duration {
  text-align: right;
}

#bar {
  width: 1fr;
}

#bar Bar {
  width: 1fr;
}

#spacer {
  width: 1fr;
}
LoginScreen {
    align: center middle;
}
#login {
    width: 50;
    height: auto;
    padding: 1 2;
    border: round $accent;
    background: $surface;
}
#login-error {
    color: $error;
    height: auto;
}